# 环境变量示例。复制为 backend/.env（已被 .gitignore 忽略）后，用下面的方式注入到启动环境。
# Spring Boot 不会自动读取 .env，请在启动前导出这些变量：
#   Git Bash:    export JWT_SECRET=... DB_PASSWORD=... ADMIN_INIT_PASSWORD=...
#   PowerShell:  $env:JWT_SECRET="..."; $env:DB_PASSWORD="..."
#   或直接在 IDE 的运行配置里添加环境变量。

# 数据库账号密码（本地 MySQL，仓库不提交真实口令）
DB_USERNAME=root
DB_PASSWORD=123456

# JWT 密钥：至少 32 字节，务必随机生成，不要复用任何已知字符串。
#   Git Bash:    openssl rand -base64 48
#   PowerShell:  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=

# 允许跨域的前端来源，逗号分隔（默认 http://localhost:5173）
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 首次启动自动创建默认管理员 admin 的初始密码；留空则自动生成随机密码并打印到日志
ADMIN_INIT_PASSWORD=
